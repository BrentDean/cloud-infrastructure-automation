#cloud-config
ssh_pwauth: false
disable_root: true
users:
  - default
  - name: labops
    gecos: Disposable Kubernetes lab operator
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}
package_update: true
packages:
  - python3
  - curl
  - ca-certificates
